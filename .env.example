# Copie para .env.local para rodar no seu computador. Na Cloudflare Pages, cadastre as mesmas duas
# variáveis em Settings > Environment variables. A chave "anon" é pública por natureza (a segurança
# está nas regras do banco). NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
# Número oficial do WhatsApp Business da Kivio (só números, com 55 + DDD). Opcional por enquanto.
VITE_WHATSAPP_OFICIAL=
